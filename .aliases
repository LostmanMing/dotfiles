# ── Shell ─────────────────────────────────────────────
alias path='echo -e ${PATH//:/\\n}'
alias please='sudo $(history -p !!)'

# ── Git (daily) ────────────────────────────────────────
alias gs='git status'
alias ga='git add --all'
alias gad='git add'
alias gc='git commit -m'
alias gcm='git commit'
alias gp='git push'
alias gpu='git push -u origin HEAD'
alias gq='git pull'
alias gf='git fetch --prune'
alias gl='git log'
alias gll='git log --graph --oneline --decorate'
alias gd='git diff'
alias gdc='git diff --cached'

# ── Git (common) ───────────────────────────────────────
alias gco='git checkout'
alias gg='git switch'
alias ggo='git switch -c'
alias gm='git merge'
alias gca='git commit --amend'
alias gt='git stash'
alias gtp='git stash pop'
alias gr='git restore'
alias grs='git restore --staged'
alias gcl='git clone'
alias gcl1='git clone --depth=1'
alias gba='git branch -avv'
alias gbd='git branch -d'
alias gcp='git cherry-pick'

# ── Git (occasional) ───────────────────────────────────
alias gk='git reset'
alias gkh='git reset --hard'
alias gkha='git reset --hard HEAD^'
alias gks='git reset --soft'
alias gksa='git reset --soft HEAD^'
alias grc='git rm --cached'
alias gsmu='git submodule update --init --recursive'
alias g='git'

# ── Misc ───────────────────────────────────────────────
alias dsh-tui='dsh --profile tui'
alias p='python'
alias h='history | tail'
alias mi='make -j$(nproc) && make install'
alias ff='fastfetch'

# ── Functions ──────────────────────────────────────────
# 查别名：al git → 只列出含 git 的别名定义；无参数列全部（名字青色，对齐）
# 输出按名字字母序，而非文件定义顺序。所有 git 别名都以 g 开头、非 git 的
# （path/please/p/h/mi/ff）无一以 g 开头，所以字母序排完 git 那批自然连成一块。
# 文件里的 daily/common/occasional 分区不体现在输出里，只在文件内可见。
# 接 less -FRX：全量列出会超一屏，而 al gcl 这种两三行的结果直接打印、不分页。
al() {
    \grep '^alias ' ~/.aliases | \grep -i -- "${1:-.}" | LC_ALL=C sort -t= -k1,1 | while IFS= read -r line; do
        line=${line#alias }
        name=${line%%=*}
        cmd=${line#*=}
        cmd=${cmd#\'}; cmd=${cmd%\'}
        printf '\033[1;36m%-8s\033[0m %s\n' "$name" "$cmd"
    done | less -FRX
}

# universal archive extractor
extract() {
  if [ -z "$1" ]; then
    echo "Usage: extract <file>"
  elif [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2) tar xvjf "$1"   ;;
      *.tar.gz)  tar xvzf "$1"   ;;
      *.tar.xz)  tar xvJf "$1"   ;;
      *.lzma)    unlzma "$1"     ;;
      *.bz2)     bunzip2 "$1"    ;;
      *.rar)     unrar x -ad "$1" ;;
      *.gz)      gunzip "$1"     ;;
      *.tar)     tar xvf "$1"    ;;
      *.tbz2)    tar xvjf "$1"   ;;
      *.tgz)     tar xvzf "$1"   ;;
      *.zip)     unzip "$1"      ;;
      *.Z)       uncompress "$1" ;;
      *.7z)      7z x "$1"       ;;
      *.xz)      unxz "$1"       ;;
      *)         echo "extract: '$1' - unknown format" ;;
    esac
  else
    echo "$1 - file does not exist"
  fi
}
